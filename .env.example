PORT=4011

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=popia_guard
# Leave unset for local dev. Set to "true" when DB_HOST points at a hosted
# Postgres that requires an encrypted connection (Neon, Render Postgres,
# etc.) — without it the connection is rejected outright.
DB_SSL=

# Where the frontend runs, for CORS and for links in outgoing emails
# (password reset, team invites).
FRONTEND_URL=http://localhost:4010

# Signs/verifies JWTs. Generate a real one per environment — never reuse
# across dev/staging/production, never commit the real value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-generated-secret
JWT_EXPIRES_IN=12h

# Outgoing email (password-reset links, team-invite links, daily
# compliance-digest emails) — see src/email/email.service.ts. Works with
# any SMTP provider; leave SMTP_HOST unset to keep running locally with
# emails just logged instead of sent.
#
#   Resend        SMTP_HOST=smtp.resend.com        PORT=587  USER=resend            PASS=<API key>
#   SendGrid      SMTP_HOST=smtp.sendgrid.net       PORT=587  USER=apikey            PASS=<API key>
#   Gmail         SMTP_HOST=smtp.gmail.com          PORT=587  USER=<gmail address>   PASS=<App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="POPIAGuard <no-reply@popiaguard.co.za>"

# Where uploaded compliance files (operator agreements, policy documents)
# are written — see src/storage/local-disk.storage.ts. Only used when
# S3_BUCKET (below) is unset.
UPLOADS_DIR=./uploads

# Object storage — see src/storage/s3.storage.ts. Leave S3_BUCKET unset to
# keep using local disk. Works with any S3-compatible provider (Cloudflare
# R2, AWS S3, Backblaze B2, DigitalOcean Spaces, MinIO).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
